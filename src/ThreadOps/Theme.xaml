<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta -->
    <Color x:Key="CyanColor">#00F0FF</Color>
    <Color x:Key="MagentaColor">#FF2BD6</Color>
    <SolidColorBrush x:Key="BgBrush" Color="#04060C"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#C70A1220"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2E00F0FF"/>
    <SolidColorBrush x:Key="LineStrongBrush" Color="#7300F0FF"/>
    <SolidColorBrush x:Key="CyanBrush" Color="{StaticResource CyanColor}"/>
    <SolidColorBrush x:Key="MagentaBrush" Color="{StaticResource MagentaColor}"/>
    <SolidColorBrush x:Key="LimeBrush" Color="#7DFF6B"/>
    <SolidColorBrush x:Key="AmberBrush" Color="#FFB547"/>
    <SolidColorBrush x:Key="RedBrush" Color="#FF4D6D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#D8F6FF"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#6D8AA3"/>

    <FontFamily x:Key="DisplayFont">Bahnschrift SemiBold, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <DropShadowEffect x:Key="CyanGlow" Color="{StaticResource CyanColor}" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/>

    <!-- Painel com borda neon -->
    <Style x:Key="NeonPanel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>

    <Style x:Key="PanelTitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="PanelSubtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="FieldLabel" TargetType="TextBlock" BasedOn="{StaticResource PanelSubtitle}">
        <Setter Property="Margin" Value="0,0,0,6"/>
    </Style>

    <!-- Campo de texto -->
    <Style x:Key="NeonInput" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Bd" Background="#0A00F0FF" BorderBrush="{StaticResource LineStrongBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="8,7">
                        <ScrollViewer x:Name="PART_ContentHost"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource CyanGlow}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Botões -->
    <Style x:Key="NeonButton" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
        <Setter Property="Background" Value="#2200F0FF"/>
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Padding" Value="10,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.7"
                                                      Color="{Binding BorderBrush.Color, RelativeSource={RelativeSource TemplatedParent}}"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.75"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MagentaButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
        <Setter Property="Foreground" Value="{StaticResource MagentaBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource MagentaBrush}"/>
        <Setter Property="Background" Value="#26FF2BD6"/>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource NeonButton}">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource LineStrongBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Padding" Value="8,7"/>
    </Style>

    <!-- Filtros (chips) -->
    <Style x:Key="Chip" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="11" Padding="9,3" Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource CyanBrush}"/>
                            <Setter Property="Foreground" Value="{StaticResource CyanBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Barra do limite diário -->
    <Style x:Key="QuotaBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="#1400F0FF" CornerRadius="3"/>
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left" CornerRadius="3" Effect="{StaticResource CyanGlow}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource CyanColor}" Offset="0"/>
                                    <GradientStop Color="{StaticResource MagentaColor}" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Cartão de estatística -->
    <Style x:Key="StatCard" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="#0800F0FF"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="Margin" Value="3"/>
    </Style>
    <Style x:Key="StatValue" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
    </Style>

    <!-- Scrollbar fina -->
    <Style TargetType="ScrollBar">
        <Setter Property="Width" Value="6"/>
        <Setter Property="MinWidth" Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Track x:Name="PART_Track" IsDirectionReversed="True">
                        <Track.Thumb>
                            <Thumb>
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Border Background="#3300F0FF" CornerRadius="3"/>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Track.Thumb>
                    </Track>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
