<Window x:Class="ThreadOps.PostDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="THREAD//OPS · confirmar" Width="520" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI">
    <Border Margin="12" Style="{StaticResource NeonPanel}" Padding="18,16">
        <StackPanel>
            <TextBlock Text="SEGUIR MARCADOS" Style="{StaticResource PanelTitle}"/>
            <TextBlock x:Name="SummaryText" FontSize="14" Margin="0,8,0,4" TextWrapping="Wrap"/>
            <TextBlock x:Name="HandlesText" Style="{StaticResource PanelSubtitle}" FontSize="11" TextWrapping="Wrap"
                       MaxHeight="60" TextTrimming="CharacterEllipsis"/>

            <DockPanel Margin="0,16,0,6">
                <TextBlock x:Name="CounterText" DockPanel.Dock="Right" Style="{StaticResource PanelSubtitle}" Text="0/500"/>
                <TextBlock Text="POST NO SEU PERFIL ANTES DE SEGUIR (opcional)" Style="{StaticResource PanelSubtitle}"/>
            </DockPanel>
            <TextBox x:Name="PostBox" Style="{StaticResource NeonInput}" AcceptsReturn="True" TextWrapping="Wrap"
                     Height="110" VerticalScrollBarVisibility="Auto" MaxLength="500" TextChanged="PostBox_TextChanged"/>
            <TextBlock Text="Escreva o seu texto. O app publica exatamente o que você digitar."
                       Style="{StaticResource PanelSubtitle}" Margin="0,6,0,0" TextWrapping="Wrap"/>

            <UniformGrid Columns="3" Margin="0,16,0,0">
                <Button Content="CANCELAR" Style="{StaticResource GhostButton}" Margin="0,0,4,0" IsCancel="True" Click="Cancel_Click"/>
                <Button Content="SÓ SEGUIR" Style="{StaticResource NeonButton}" Margin="4,0,4,0" Click="FollowOnly_Click"/>
                <Button x:Name="PostAndFollowButton" Content="PUBLICAR E SEGUIR" Style="{StaticResource MagentaButton}"
                        Margin="4,0,0,0" IsEnabled="False" Click="PostAndFollow_Click"/>
            </UniformGrid>
        </StackPanel>
    </Border>
</Window>
